<?xml version="1.0" ?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <com.google.android.material.chip.ChipGroup
    android:id="@+id/layer_overlays"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    app:chipSpacingHorizontal="8dp"
    app:chipSpacingVertical="0dp"/>
  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="?dividerHorizontal"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/saved_places_heading"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:text="@string/saved_layers_title"
      android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
      android:textColor="?android:attr/textColorPrimary"/>
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/layer_visibility_summary"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:textAppearance="@style/TextAppearance.Material3.BodySmall"
      android:textColor="?android:attr/textColorSecondary"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/layer_search_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_layers_search">
    <androidx.appcompat.widget.AppCompatImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginStart="12dp"
      android:layout_marginEnd="12dp"
      android:importantForAccessibility="no"
      app:srcCompat="@drawable/ic_search"
      app:tint="?android:attr/textColorSecondary"/>
    <androidx.appcompat.widget.AppCompatEditText
      android:id="@+id/layer_search"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:background="@null"
      android:hint="@string/saved_layers_search"
      android:contentDescription="@string/saved_layers_search"
      android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
      android:textColor="?android:attr/textColorPrimary"
      android:textColorHint="?android:attr/textColorSecondary"
      android:singleLine="true"
      android:inputType="textCapSentences"
      android:imeOptions="actionDone"/>
    <androidx.appcompat.widget.AppCompatImageButton
      android:id="@+id/layer_search_clear"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?selectableItemBackgroundBorderless"
      android:contentDescription="@string/saved_layers_clear_search"
      app:srcCompat="@drawable/ic_close"
      app:tint="?android:attr/textColorSecondary"
      android:padding="14dp"/>
  </LinearLayout>
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/layer_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
    android:textColor="?android:attr/textColorSecondary"
    android:visibility="gone"/>
</LinearLayout>
