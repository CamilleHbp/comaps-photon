<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?windowBackgroundForced"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical">
    <LinearLayout
        android:id="@+id/route_start_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="52dp"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="?clickableBackground"
        android:focusable="true">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/planner_from"
          android:textSize="12sp"
          android:textColor="?android:textColorSecondary" />
      <TextView
          android:id="@+id/route_start_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:ellipsize="end"
          android:textSize="16sp"
          android:textColor="?android:textColorPrimary"
          android:textColorHint="?colorSecondary"
          android:hint="@string/planner_choose_start" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn__my_position_use"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/planner_use_location"
        android:textAllCaps="false"
        app:icon="@drawable/ic_location_crosshair"
        app:iconGravity="textStart" />
  </LinearLayout>
  <include layout="@layout/item_divider" />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical">
    <LinearLayout
        android:id="@+id/route_finish_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="52dp"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="?clickableBackground"
        android:focusable="true">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/planner_to"
          android:textSize="12sp"
          android:textColor="?android:textColorSecondary" />
      <TextView
          android:id="@+id/route_finish_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:ellipsize="end"
          android:textSize="16sp"
          android:textColor="?android:textColorPrimary"
          android:textColorHint="?colorSecondary"
          android:hint="@string/planner_choose_finish" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/swap_endpoints"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?clickableBackground"
        android:contentDescription="@string/planner_swap"
        app:srcCompat="@drawable/ic_swap_route"
        app:tint="?iconTint" />
  </LinearLayout>
</LinearLayout>
